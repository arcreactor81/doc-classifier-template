  "typeFile": {
    "types": [
      {
        "id": "data_collection_form",
        "name": "Data collection form",
        "what": "The primary purpose is for a respondent to enter data into fields, boxes or blanks, often with a signature. Attached explanatory material does not change that primary purpose.",
        "not_for": "Advice for readers without a requested response, or a publication reporting already observed measurements.",
        "examples": [
          "A blank application requesting identifying details and a signature."
        ]
      },
      {
        "id": "public_guidance",
        "name": "Public guidance",
        "what": "The primary purpose is to explain practical actions, precautions or requirements for a recurring situation so a reader can understand what to do.",
        "not_for": "A document primarily collecting respondent data, or primarily publishing measured population estimates.",
        "examples": [
          "A leaflet describing safe use of shared equipment."
        ]
      },
      {
        "id": "statistical_bulletin",
        "name": "Statistical bulletin",
        "what": "The primary content reports measured numerical estimates or counts for a population, place or period, using tables or charts with explicit units and dates.",
        "not_for": "A blank document collecting responses, or practical advice containing incidental numbers.",
        "examples": [
          "A dated sheet comparing population rates across periods and places."
        ]
      }
    ],
    "none_of_these": {
      "name": "None of these",
      "what": "The document does not fit any defined type."
    }
  },
