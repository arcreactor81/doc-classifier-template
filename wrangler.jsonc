{
  "name": "doc-classifier-generic",
  "main": "core/server/managed-worker.ts",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "doc-classifier-generic",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "doc-classifier-generic-artifacts"
    }
  ],
  "workflows": [
    {
      "binding": "DOCUMENT_WORKFLOW",
      "name": "doc-classifier-new-install-workflow-v1",
      "class_name": "DocumentWorkflow"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "OPENAI_API_KEY",
      "store_id": "demo",
      "secret_name": "OPENAI_API_KEY"
    },
    {
      "binding": "JEV_API_KEY",
      "store_id": "demo",
      "secret_name": "JEV_API_KEY"
    }
  ],
  "vars": {
    "PROJECT_ID": "generic",
    "MODEL_CALLS_ENABLED": "false",
    "BUILD_COMMIT": "unversioned",
    "DEFINITION_MODE": "runtime",
    "DEFINITION_EDITORS": "[]"
  },
  "tsconfig": "tsconfig.worker.json",
  "alias": {
    "project-pack": "./projects/generic/project.json",
    "bundled-ui": "./.wrangler/bundled-ui/worker-assets.mjs"
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/worker-ui/*.txt"
      ],
      "fallthrough": true
    }
  ]
}
