{
  "name": "doc-classifier-generic",
  "main": "core/server/worker.ts",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "doc-classifier-generic",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "doc-classifier-generic-artifacts"
    }
  ],
  "workflows": [
    {
      "binding": "DOCUMENT_WORKFLOW",
      "name": "doc-classifier-new-install-workflow-v1",
      "class_name": "DocumentWorkflow"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "OPENAI_API_KEY",
      "store_id": "demo",
      "secret_name": "OPENAI_API_KEY"
    },
    {
      "binding": "JEV_API_KEY",
      "store_id": "demo",
      "secret_name": "JEV_API_KEY"
    }
  ],
  "vars": {
    "PROJECT_ID": "generic",
    "MODEL_CALLS_ENABLED": "false",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "BUILD_COMMIT": "unversioned"
  },
  "tsconfig": "tsconfig.worker.json",
  "alias": {
    "project-pack": "./projects/generic/project.json"
  }
}
